# OpenAI API key (required for Whisper transcription and GPT answers)
OPENAI_API_KEY=sk-your-key-here

# Optional: override defaults
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
API_HOST=127.0.0.1
API_PORT=8000

# VAD (Voice Activity Detection) — опционально
# VAD_AGGRESSIVENESS=2   # 0-3, выше = строже фильтрация
# VAD_MIN_SPEECH_SEC=1.0 # мин. длина сегмента речи (сек)
